<?xml version="1.0" encoding="utf-8"?>
<!-- 클라우드 백업/기기 이전 시에도 측정 데이터를 외부로 내보내지 않음 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
