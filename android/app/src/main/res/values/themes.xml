<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ARMeasure" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/ok</item>
        <item name="colorError">@color/bad</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/bg2</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnBackground">@color/text</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="materialButtonStyle">@style/Widget.ARMeasure.Button</item>
    </style>

    <style name="Theme.ARMeasure.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Widget.ARMeasure.Button" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.ARMeasure.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.ARMeasure.Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@color/bad</item>
    </style>
    <style name="Widget.ARMeasure.ArButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">44dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">#CC141A22</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Text.Title"><item name="android:textSize">20sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/text</item></style>
    <style name="Text.Body"><item name="android:textSize">14sp</item><item name="android:textColor">@color/muted</item><item name="android:lineSpacingMultiplier">1.3</item></style>
    <style name="Text.Mono"><item name="android:fontFamily">monospace</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/text</item></style>
</resources>
